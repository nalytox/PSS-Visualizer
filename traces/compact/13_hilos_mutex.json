{"version":2,"arch":"x86_64","source":"#include <pthread.h>\n#include <stdio.h>\n\nint contador = 0;\npthread_mutex_t candado = PTHREAD_MUTEX_INITIALIZER;\n\nvoid *sumar(void *arg) {\n    for (int i = 0; i < 3; i++) {\n        pthread_mutex_lock(&candado);\n        int leido = contador;\n        leido = leido + 1;\n        contador = leido;\n        pthread_mutex_unlock(&candado);\n    }\n    return NULL;\n}\n\nint main(void) {\n    pthread_t a, b;\n    pthread_create(&a, NULL, sumar, NULL);\n    pthread_create(&b, NULL, sumar, NULL);\n    pthread_join(a, NULL);\n    pthread_join(b, NULL);\n    printf(\"contador = %d\\n\", contador);\n    return 0;\n}\n","stdin":"","run":{"policy":"round_robin","seed":0,"stdinEof":false,"schedule":[],"injections":[],"limits":{"maxProcesses":32,"maxThreadsPerProcess":16,"maxSteps":1000000,"wallTimeMs":600000,"memoryBytes":268435456,"outputBytesPerProcess":65536,"traceBytesCompressed":134217728}},"compile":{"ok":true,"command":"gcc -g -O0 -fno-omit-frame-pointer -pthread -no-pie -Wall -Wl,-z,now -o prog prog.c","diagnostics":[]},"outcome":{"kind":"exited","code":0},"truncated":false,"output":[{"t":56,"pid":1000,"fd":1,"stream":"stdout","bytes":"contador = 6\n"}],"summary":{"leaks":[],"memErrors":[]},"stepCount":59,"index":{"actorPid":"H4sIAAAAAAAA/+XDMQ0AAAACIDb79zSGQTyA5sMAG6Zf3uwAAAA=","actorTid":"H4sIAAAAAAAA/72OwQkAMAwCD7L/no1T9NmjkG8ecioIApyCrsd83uyhj7S181czytYFUldVTuwAAAA=","actorLine":"H4sIAAAAAAAA/8WKuQ0AIQDDUt7xCBre/QclhQs2oLCSyJGkZj7TzX/1wI5kMhn/whVcxQk/+Aw+FTfNMpt9ALhwywPsAAAA","flags":"H4sIAAAAAAAA/8WO0QkAIAhET+mnNZokpMEardHyEMEm6MHhneeHANAR5CQCdZ2Srfgl+NglhhZGeTOFPz8d9zvycF1S+gQ77AAAAA==","pids":[1000],"threads":[{"pid":1000,"tid":1000},{"pid":1000,"tid":1001},{"pid":1000,"tid":1002}],"forks":[],"mutexes":["m0"]},"chunks":[{"start":0,"count":5,"firstSnapshot":0,"data":""},{"start":5,"count":5,"firstSnapshot":5,"data":""},{"start":10,"count":5,"firstSnapshot":9,"data":""},{"start":15,"count":5,"firstSnapshot":14,"data":""}